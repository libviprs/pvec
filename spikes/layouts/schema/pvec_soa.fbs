// Candidate A: type-batched structure-of-arrays block. One table per kind, one vector per field.
namespace soa;

table LineBatch { ids:[uint]; ax:[double]; ay:[double]; bx:[double]; by:[double]; }
table CircleBatch { ids:[uint]; cx:[double]; cy:[double]; r:[double]; }
table ArcBatch { ids:[uint]; cx:[double]; cy:[double]; r:[double]; a0:[double]; a1:[double]; }
table EllipseBatch { ids:[uint]; cx:[double]; cy:[double]; a:[double]; b:[double]; rot:[double]; t0:[double]; t1:[double]; }
// Offsets are n+1 long and index the arena vectors; cps are interleaved x,y.
table PolylineBatch { ids:[uint]; voff:[uint]; xs:[double]; ys:[double]; }
table SplineBatch { ids:[uint]; degree:[ubyte]; cp_off:[uint]; knot_off:[uint]; w_off:[uint]; cps:[double]; knots:[double]; weights:[double]; }
// Parts of composite i are tags[part_off[i]..part_off[i+1]] (0 = line, 1 = arc); their values are
// data[data_off[i]..data_off[i+1]], 4 doubles per line and 5 per arc.
table CompositeBatch { ids:[uint]; part_off:[uint]; data_off:[uint]; tags:[ubyte]; data:[double]; }

table Block {
  lines:LineBatch; circles:CircleBatch; arcs:ArcBatch; ellipses:EllipseBatch;
  polylines:PolylineBatch; splines:SplineBatch; composites:CompositeBatch;
}
root_type Block;
